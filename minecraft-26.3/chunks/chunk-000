</head>
<body>
  <canvas id="mc-canvas" tabindex="0"></canvas>
  <div id="boot-screen" aria-hidden="true"></div>
  <div id="boot-brand" aria-hidden="true">MINECRAFT<span>26.3</span></div>
  <div id="gaius-shell-header" data-gaius-shell="v2" aria-hidden="true">
    <div id="gaius-shell-brand"><strong>MINECRAFT</strong><span>26.3</span></div>
    <span id="gaius-shell-mode"></span>
    <span id="gaius-shell-version">VERSION 0.3.3</span>
  </div>
  <pre id="status" data-state="running" hidden>Starting Minecraft 26.3 26.3...</pre>
  <div id="gaius-error-actions" hidden>
    <button id="gaius-retry" type="button">Retry startup</button>
    <button id="gaius-error-toggle" type="button">Show diagnostics</button>
  </div>
  <pre id="gaius-error-details" hidden></pre>
  <div id="gaius-shell-footer" data-gaius-shell="v2" aria-hidden="true">
    <span></span>
    <span>HTML runtime | local storage enabled</span>
  </div>
  <div id="boot-progress" aria-hidden="true"><div id="boot-progress-bar"></div></div>
  <div id="boot-progress-text">0% Initializing...</div>
  <div id="perf-hud">FPS --</div>

